# Copy to .env. Everything is optional: without keys, the app uses manual listings and a mock card.
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# 0.0.0.0 lets a phone on the same network reach the API. Use 127.0.0.1 on public Wi-Fi.
HOST=0.0.0.0

# true = 60-second auctions and a 30-second pickup window
DEMO_MODE=true
JWT_SECRET=change-me

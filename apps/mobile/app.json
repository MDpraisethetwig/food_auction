{
  "expo": {
    "name": "Full for Less",
    "slug": "lastcall",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E4D3B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Full for Less uses the camera to scan pickup codes and photograph food."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Full for Less uses the camera to photograph food for listings.",
          "photosPermission": "Full for Less uses your photos for food listings."
        }
      ],
      "expo-audio"
    ],
    "scheme": "lastcall"
  }
}
